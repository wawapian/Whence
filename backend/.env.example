LLM_PROVIDER=deepseek            # deepseek / kimi / qwen（base_url/model 自动按预设填）
LLM_API_KEY=
# LLM_BASE_URL=                  # 可选：覆盖 provider 预设
# LLM_MODEL=                     # 可选：覆盖 provider 预设
VLM_MODEL=                  # 空 = 关闭图片理解；填 qwen3-vl-plus 启用
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_ENGINE=local          # off / local / llm
RERANK_MODEL=BAAI/bge-reranker-base
QUERY_REWRITE=off            # off / auto；auto = 长问题先做多查询扩展再检索
QUERY_REWRITE_MIN_CHARS=15   # auto 模式触发阈值：问题长度 ≥ 此值才扩展
QA_ENGINE=tool_loop          # tool_loop = 模型主导主循环 + 五工具；legacy = 旧 4 管线（回退开关）
QA_MAX_ROUNDS=4              # 工具调用轮数上限（spec 已决；随实测调）
IMAGE_FILTER=on              # 装饰小图降级（极小且均匀纯色块：不自动描述/不进图片清单；文件与行保留）；off 可关
ADVANCED_ENGINE=off          # off / docling（PDF 表格与复杂版式；解析在上传后台跑，慢约 1-2 分钟/份，提问不受影响）
DATA_DIR=./data

# Local model launcher; relative paths resolve from backend/.
EMBEDDING_MODEL_FILE=models/bge-m3-Q8_0.gguf
RERANK_MODEL_FILE=models/bge-reranker-base-Q8_0.gguf
LLAMA_SERVER_BINARY=llama/llama-server.exe
LLAMA_THREADS=8
LLAMA_EMBED_CONTEXT=8192

LLAMA_EMBED_URL=http://127.0.0.1:8094
LLAMA_RERANK_URL=http://127.0.0.1:8095
